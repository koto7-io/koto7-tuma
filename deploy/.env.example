# Copy to deploy/.env before any non-local deployment.
# docker compose automatically loads deploy/.env when present.

# --- Required for production ---

# 32 ASCII bytes. Encrypts provider signing secrets at rest.
# Generate once: openssl rand -base64 24 | head -c 32
# NEVER change after data exists unless you re-enter all connection secrets.
# TUMA_ENCRYPTION_KEY=

# Public URL providers POST webhooks to (must match what you give Stripe/GitHub/etc.)
# Use https:// in production — session cookies get Secure flag automatically.
# TUMA_PUBLIC_BASE_URL=https://hooks.example.com

# --- Admin login (set BEFORE first boot) ---

# TUMA_ADMIN_EMAIL=ops@yourdomain.com
# TUMA_ADMIN_PASSWORD=   # long random string; if unset on first boot, one is generated and logged once

# --- Postgres (override compose defaults) ---

# POSTGRES_PASSWORD=
# DATABASE_URL=postgres://tuma:STRONG_PASSWORD@postgres:5432/tuma?sslmode=disable

# --- Grafana (exposed on host :3001 in default compose) ---

# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=   # default compose uses "tuma" — change this

# --- Optional tuning ---

# Optional: separate 32-byte key for webhook payload encryption at rest.
# Defaults to TUMA_ENCRYPTION_KEY when unset.
# TUMA_PAYLOAD_KEY=

# TUMA_SESSION_TTL_HOURS=168
# TUMA_PER_CONN_CONCURRENCY=10
# TUMA_MAX_BODY_BYTES=1048576

# --- Demo playground (tuma-demo.koto7.dev only) ---

# TUMA_DEMO_MODE=true
# TUMA_PLAYGROUND_SESSION_TTL_HOURS=2
# TUMA_PLAYGROUND_MAX_SESSIONS=500
# TUMA_PLAYGROUND_INTERNAL_BASE=http://tuma-api:8080
