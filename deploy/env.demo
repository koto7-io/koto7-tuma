# Copy to deploy/.env on the demo droplet (or merge these lines in).
# Playground auto-enables when TUMA_PUBLIC_BASE_URL contains tuma-demo.koto7.dev,
# but setting TUMA_DEMO_MODE=true explicitly is still recommended.

TUMA_PUBLIC_BASE_URL=https://tuma-demo.koto7.dev
TUMA_DEMO_MODE=true
TUMA_PLAYGROUND_INTERNAL_BASE=http://tuma-api:8080
TUMA_PLAYGROUND_SESSION_TTL_HOURS=2
TUMA_PLAYGROUND_MAX_SESSIONS=500

# Generate once per environment — do not reuse the compose dev default in production.
# TUMA_ENCRYPTION_KEY=
# TUMA_ADMIN_EMAIL=ops@example.com
# TUMA_ADMIN_PASSWORD=
